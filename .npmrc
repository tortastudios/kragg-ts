# IMPORTANT — read before adding anything here.
#
# As of pnpm v11, pnpm reads ONLY auth and registry settings from .npmrc.
# Every other pnpm setting placed in this file is SILENTLY IGNORED, which is
# worse than useless: it creates false confidence. All pnpm supply-chain
# hardening for this repo lives in `pnpm-workspace.yaml`. Put it there.
#
# The one key below is kept deliberately, and NOT for pnpm's benefit:
# `npm` and `npx` do still honour it. If a human or CI step reaches for npm
# in this directory by mistake, dependency lifecycle scripts still will not
# run. pnpm's equivalent control is `ignoreScripts: true` in
# pnpm-workspace.yaml — that is the one that actually governs `pnpm install`.
ignore-scripts=true

# Exact versions only. No `^`, no `~`, no floating ranges.
#
# Same caveat as above: this governs `npm`, NOT `pnpm`. pnpm's equivalent
# (a save-prefix setting in pnpm-workspace.yaml) has NOT been verified for
# pnpm v11 and is deliberately not guessed at — a wrong key name would look
# like protection and provide none. Until it is confirmed, exact pinning in
# this repo is enforced by review: `pnpm add` writes a caret range by
# default, so pin the version by hand in package.json afterwards.
save-exact=true
